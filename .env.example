# Copy to .env.local for your machine; in production set these in your host's settings. Never commit real values.

# 1. Sessions: any long random string (openssl rand -hex 32).
SESSION_SECRET=

# 2. The chain: Base Sepolia (a test network) unless you point at your local fork (npm run chain).
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# 3. Wallet payments through Access0x1: your merchant id (npm run merchant, README step 3).
NEXT_PUBLIC_ACCESS0X1_MERCHANT=

# 4. Card payments through SebasTN: your merchant id from https://sebastn.com after you connect Stripe.
NEXT_PUBLIC_SEBASTN_MERCHANT=

# 5. Pay per call (x402): YOUR wallet address that receives payments (public address only, never a private key).
X402_PAY_TO=
# Local testing on an anvil fork: payments are checked and settled in this app. localhost only.
# X402_LOCAL_RPC=http://127.0.0.1:8545
# Real payments on Base mainnet: set all three.
# X402_NETWORK=eip155:8453
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
